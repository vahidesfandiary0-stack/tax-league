# Copy to .env locally. Never commit real secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
LANGUAGE_CODE=fa
TIME_ZONE=Asia/Tehran

# CafeBazaar Developer API (keep blank until production credentials are provisioned)
# Store real values only in the protected server .env.production file.
BAZAAR_CLIENT_ID=
BAZAAR_CLIENT_SECRET=
BAZAAR_REFRESH_TOKEN=
BAZAAR_PACKAGE_NAME=ir.raqtiva.tax_league
