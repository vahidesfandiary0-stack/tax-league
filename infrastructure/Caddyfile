raqtiva.ir, www.raqtiva.ir {
        encode zstd gzip

        handle_path /media/showcase/* {
                root * /srv/media/showcase
                file_server
        }

        handle {
                reverse_proxy 127.0.0.1:8000 {
                        header_up -X-Forwarded-Host
                }
        }
}
