# نمونه متغیرهای محیطی production؛ مقادیر واقعی را هرگز در Git ثبت نکنید.
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=generate-a-unique-random-secret-at-least-50-characters
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.example.com
DATABASE_URL=postgresql://taxleague:CHANGE_ME@127.0.0.1:5432/taxleague
REDIS_URL=redis://127.0.0.1:6379/0
LANGUAGE_CODE=fa
TIME_ZONE=Asia/Tehran
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
DJANGO_CORS_ALLOWED_ORIGINS=https://admin.example.com
